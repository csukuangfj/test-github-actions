#
# Automatically generated by crosstool-NG 1.25.x
#

# ======================================================
# Global paths & logging
# ======================================================
CT_CONFIGURE_has_static_link=y
CT_LOCAL_TARBALLS_DIR="/opt/src"
CT_WORK_DIR="/opt/build"
CT_PREFIX_DIR="/opt/x-tools/${CT_TARGET}"
CT_INSTALL_DIR_RO=y

CT_LOG_ERROR=y
CT_LOG_WARN=y
CT_LOG_INFO=y
CT_LOG_DEBUG=y
CT_LOG_LEVEL_MAX="DEBUG"

# ======================================================
# Target
# ======================================================
CT_TARGET="armv7-unknown-linux-gnueabihf"

CT_ARCH_ARM=y
CT_ARCH_ARM_MODE_ARM=y
CT_ARCH_ARM_EABI=y
CT_ARCH_ARM_FLOAT_HW=y
CT_ARCH_ARM_FPU="vfpv3"
CT_ARCH_ARM_NEON=y

# ======================================================
# Kernel headers (manylinux2014 compatible)
# ======================================================
CT_KERNEL_linux=y
CT_KERNEL_VERSION="4.14"
CT_KERNEL_LINUX_CUSTOM_HEADERS=y
CT_KERNEL_LINUX_CUSTOM_HEADERS_VERSION="4.14"

# ======================================================
# Binutils
# ======================================================
CT_BINUTILS=y
CT_BINUTILS_BINUTILS=y
CT_BINUTILS_VERSION="2.36.1"

# ======================================================
# GCC
# ======================================================
CT_CC=y
CT_CC_GCC=y
CT_CC_GCC_VERSION="11.4.0"

CT_CC_LANG_C=y
CT_CC_LANG_CXX=y

CT_CC_GCC_ENABLE_GRAPHITE=n
CT_CC_GCC_ENABLE_LTO=n
CT_CC_GCC_ENABLE_PLUGINS=n
CT_CC_GCC_ENABLE_PIE=n

CT_CC_GCC_LIBSTDCXX=y
CT_CC_GCC_USE_GMP_MPFR=y

# ======================================================
# C library: glibc 2.17
# ======================================================
CT_LIBC=y
CT_LIBC_GLIBC=y
CT_GLIBC_VERSION="2.17"

CT_GLIBC_ENABLE_NPTL=y
CT_GLIBC_ENABLE_WCHAR=y
CT_LIBC_GLIBC_USE_PORTS=y

# ---- disable modern glibc security features ----
CT_GLIBC_ENABLE_CET=n
CT_GLIBC_ENABLE_SSP=n
CT_GLIBC_ENABLE_STACKGUARD=n

# ======================================================
# Companion libraries (HOST ONLY)
# ======================================================
CT_COMP_LIBS=y

# ---- zlib: FORCE bundled, NO external fetch ----
CT_COMP_LIBS_ZLIB=y
CT_ZLIB_BUNDLED=y

# ---- other companion libs (safe defaults) ----
CT_COMP_LIBS_GMP=y
CT_COMP_LIBS_MPFR=y
CT_COMP_LIBS_ISL=y

# ======================================================
# Build behavior
# ======================================================
CT_BUILD_PARALLEL=y
CT_PARALLEL_JOBS=0

CT_WANTS_STATIC_LINK=y
CT_WANTS_STATIC_LINK_CXX=y

# ======================================================
# Debug / reproducibility
# ======================================================
CT_DEBUG_CT=y
CT_DEBUG_CT_SAVE_STEPS=y
CT_DEBUG_CT_SAVE_CONFIG=y

