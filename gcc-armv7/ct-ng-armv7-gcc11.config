CT_CONFIG_VERSION="4"

CT_ARCH_ARM=y
CT_ARCH_ARM_MODE_ARM=y
CT_ARCH_ARM_EABI=y
CT_ARCH_ARM_V7=y
CT_ARCH_ARM_FPU_NEON=y
CT_ARCH_FLOAT_HW=y

CT_TARGET="armv7-unknown-linux-gnueabihf"

CT_KERNEL_LINUX=y
CT_KERNEL_VERSION="5.10.210"

CT_BINUTILS_VERSION="2.40"

CT_CC_GCC=y
CT_CC_GCC_VERSION="11.4.0"

CT_CC_LANG_C=y
CT_CC_LANG_CXX=y

CT_LIBC_GLIBC=y
CT_LIBC_GLIBC_VERSION="2.17"

CT_LIBC_GLIBC_FORCE_UNWIND=y
CT_LIBC_GLIBC_ENABLE_CXX=y

CT_THREADS_POSIX=y
CT_SHARED_LIBS=y
CT_DISABLE_MULTILIB=y

CT_WANTS_STATIC_LINK=y
CT_WANTS_STATIC_LINK_CXX=y

CT_USE_SYSROOT=y
CT_SYSROOT_NAME="sysroot"

CT_BUILD_TOP_DIR="/opt/build"
CT_PREFIX_DIR="/opt/x-tools"

CT_LOG_PROGRESS_BAR=y
CT_LOG_EXTRA=y

