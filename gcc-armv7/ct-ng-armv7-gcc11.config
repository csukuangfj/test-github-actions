# -------------------------------------------------
# Crosstool-NG configuration
# Target: armv7-unknown-linux-gnueabihf
# GCC 11.4.0 + glibc 2.17 (manylinux2014)
# -------------------------------------------------

CT_CONFIG_VERSION="4"

# -------------------------------------------------
# Paths and misc
# -------------------------------------------------
CT_LOCAL_TARBALLS_DIR="${HOME}/.ct-ng/tarballs"
CT_SAVE_TARBALLS=y
CT_WORK_DIR="/opt/build"
CT_PREFIX_DIR="/opt/x-tools"
CT_SYSROOT_NAME="sysroot"
CT_USE_SYSROOT=y

# -------------------------------------------------
# Target
# -------------------------------------------------
CT_TARGET="armv7-unknown-linux-gnueabihf"

# -------------------------------------------------
# Architecture
# -------------------------------------------------
CT_ARCH_ARM=y
CT_ARCH_ARM_MODE_ARM=y
CT_ARCH_ARM_EABI=y
CT_ARCH_ARM_V7=y
CT_ARCH_ARM_FPU_NEON=y
CT_ARCH_FLOAT_HW=y
CT_ARCH_ARM_TUPLE_USE_EABIHF=y

# Tune flags (safe defaults for armv7l)
CT_ARCH_ARM_CPU="generic"
CT_ARCH_ARM_ARCH="armv7-a"

# -------------------------------------------------
# Kernel headers
# -------------------------------------------------
CT_KERNEL_LINUX=y
CT_KERNEL_VERSION="3.10.108"
CT_KERNEL_LINUX_CUSTOM=y

# -------------------------------------------------
# Binutils
# -------------------------------------------------
CT_BINUTILS=y
CT_BINUTILS_VERSION="2.40"

# -------------------------------------------------
# C compiler
# -------------------------------------------------
CT_CC=y
CT_CC_GCC=y
CT_CC_GCC_VERSION="11.4.0"

CT_CC_LANG_C=y
CT_CC_LANG_CXX=y

CT_CC_GCC_ENABLE_PLUGINS=y
CT_CC_GCC_ENABLE_LTO=y

CT_CC_GCC_EXTRA_CONFIG_ARRAY="--disable-libsanitizer"

# -------------------------------------------------
# C library
# -------------------------------------------------
CT_LIBC=y
CT_LIBC_GLIBC=y
CT_LIBC_GLIBC_VERSION="2.17"

# glibc 2.17 必须项
CT_LIBC_GLIBC_FORCE_UNWIND=y
CT_LIBC_GLIBC_ENABLE_OBSOLETE_RPC=y
CT_LIBC_GLIBC_EXTRA_CONFIG_ARRAY="libc_cv_forced_unwind=yes libc_cv_c_cleanup=yes"

# -------------------------------------------------
# Threads / ABI
# -------------------------------------------------
CT_THREADS_POSIX=y
CT_SHARED_LIBS=y
CT_DISABLE_MULTILIB=y

# -------------------------------------------------
# Patches  (非常关键)
# -------------------------------------------------
# 强制只使用官方 bundled patches
CT_PATCH=y
CT_PATCH_BUNDLED=y
CT_PATCH_BUNDLED_EXP=n
CT_PATCH_LOCAL=n

CT_PATCH_NONE=n
CT_PATCH_BUNDLED_LOCAL=n
CT_PATCH_BUNDLED_BUNDLED_EXP=n
CT_PATCH_BUNDLED_BUNDLED_EXP_LOCAL=n

# -------------------------------------------------
# Tools
# -------------------------------------------------
CT_COMP_TOOLS=y
CT_COMP_TOOLS_MAKE=y
CT_COMP_TOOLS_MAKE_VERSION="4.3"
CT_COMP_TOOLS_AUTOCONF=y
CT_COMP_TOOLS_AUTOCONF_VERSION="2.71"
CT_COMP_TOOLS_AUTOMAKE=y
CT_COMP_TOOLS_AUTOMAKE_VERSION="1.16.5"
CT_COMP_TOOLS_LIBTOOL=y
CT_COMP_TOOLS_LIBTOOL_VERSION="2.4.7"

# -------------------------------------------------
# Logging (必须打开，CI 才能 debug)
# -------------------------------------------------
CT_LOG_PROGRESS_BAR=y
CT_LOG_ALL=y
CT_LOG_LEVEL_MAX=y
CT_LOG_ERROR=y
CT_LOG_WARN=y
CT_LOG_INFO=y
CT_LOG_DEBUG=y

# -------------------------------------------------
# Parallelism (防止 OOM)
# -------------------------------------------------
CT_PARALLEL_JOBS=4
CT_LOAD=0

# -------------------------------------------------
# Build behavior
# -------------------------------------------------
CT_FORCE_DOWNLOAD=y
CT_WGET=y
CT_TAR=y
CT_UNZIP=y

# -------------------------------------------------
# Debug / Safety
# -------------------------------------------------
CT_DEBUG_CT=y
CT_DEBUG_CT_SAVE_STEPS=y

